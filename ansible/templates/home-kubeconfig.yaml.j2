# Managed by pi-cluster 30-workstation.yml. Contains cluster-admin credentials: never commit.
apiVersion: v1
kind: Config
clusters:
  - name: {{ kube_context }}
    cluster:
      server: {{ kube_api_server }}
      certificate-authority-data: {{ k3s_kc.clusters[0].cluster['certificate-authority-data'] }}
users:
  - name: {{ kube_context }}
    user:
      client-certificate-data: {{ k3s_kc.users[0].user['client-certificate-data'] }}
      client-key-data: {{ k3s_kc.users[0].user['client-key-data'] }}
contexts:
  - name: {{ kube_context }}
    context:
      cluster: {{ kube_context }}
      user: {{ kube_context }}
